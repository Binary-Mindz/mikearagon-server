<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Email Verification</title>
  </head>

  <body
    style='margin:0; padding:0; font-family: Arial, sans-serif; background-color:#f5f5f5;'
  >

    <!-- Wrapper -->
    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color:#f5f5f5; padding:20px 0;'
    >
      <tr>
        <td align='center'>

          <!-- Main Container -->
          <table
            width='500'
            cellpadding='0'
            cellspacing='0'
            style='background:#ffffff; border-radius:10px; overflow:hidden;'
          >

            <!-- Header -->
            <tr>
              <td
                style='background:#c62828; color:#ffffff; padding:20px; text-align:left;'
              >
                <h2 style='margin:0;'>{{appName}}</h2>
                <p style='margin:5px 0 0;'>Verify Your Email</p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style='padding:30px; text-align:left;'>

                <h3 style='margin-top:0;'>Hello {{name}},</h3>

                <p style='color:#555;'>
                  Thank you for signing up. Please verify your email address to
                  activate your account.
                </p>

                <!-- Card -->
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  style='background:#f9f9f9; border-radius:8px; padding:20px; margin:20px 0;'
                >
                  <tr>
                    <td align='center'>

                      <p style='margin:0 0 15px; color:#333;'>
                        Click the button below to verify your email:
                      </p>

                      <!-- Button -->
                      <a
                        href='{{verificationLink}}'
                        style='display:inline-block; padding:12px 25px; background:#c62828; color:#ffffff; text-decoration:none; border-radius:6px; font-weight:bold;'
                      >
                        Verify Email
                      </a>

                    </td>
                  </tr>
                </table>

                <p style='color:#777; font-size:14px;'>
                  If you didn’t create an account, you can safely ignore this
                  email.
                </p>

                <p style='color:#777; font-size:14px;'>
                  Or copy and paste this link into your browser:
                </p>

                <p style='word-break:break-all; font-size:13px; color:#c62828;'>
                  {{verificationLink}}
                </p>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='background:#f1f1f1; text-align:center; padding:15px; font-size:12px; color:#888;'
              >
                ©
                {{year}}
                {{appName}}. All rights reserved.
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>