<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Reset Your Password</title>
  </head>

  <body
    style='margin:0; padding:0; font-family: Arial, sans-serif; background-color:#f5f5f5;'
  >

    <!-- Wrapper -->

    <table
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color:#f5f5f5; padding:20px 0;'
    >
      <tr>
        <td align='center'>
          <!-- Main Container -->
          <table
            width='500'
            cellpadding='0'
            cellspacing='0'
            style='background:#ffffff; border-radius:10px; overflow:hidden;'
          >

            <!-- Header -->
            <tr>
              <td style='background:#c62828; color:#ffffff; padding:20px;'>
                <h2 style='margin:0;'>{{appName}}</h2>
                <p style='margin:5px 0 0;'>Password Reset Request</p>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style='padding:30px;'>

                <h3 style='margin-top:0;'>Hello {{name}}, 👋</h3>

                <p style='color:#555;'>
                  We received a request to reset your password. Use the
                  verification code below to proceed.
                </p>

                <!-- OTP Card -->
                <table
                  align='center'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  style='background:#f9f9f9; border-radius:8px; padding:25px; margin:25px 0; text-align:center;'
                >
                  <tr>
                    <td>

                      <p style='margin:0 0 10px; color:#888; font-size:14px;'>
                        Your verification code
                      </p>

                      <!-- OTP -->
                      <div
                        style='font-size:32px; letter-spacing:8px; font-weight:bold; color:#c62828;'
                      >
                        {{otp}}
                      </div>

                      <p style='margin-top:15px; font-size:13px; color:#888;'>
                        This code will expire in
                        {{expiry}}
                        minutes
                      </p>

                    </td>
                  </tr>
                </table>

                <p style='color:#777; font-size:14px;'>
                  If you didn’t request a password reset, you can safely ignore
                  this email.
                </p>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style='background:#f1f1f1; text-align:center; padding:15px; font-size:12px; color:#888;'
              >
                ©
                {{year}}
                {{appName}}. All rights reserved.
              </td>
            </tr>

          </table>

        </td>
      </tr>

    </table>

  </body>
</html>