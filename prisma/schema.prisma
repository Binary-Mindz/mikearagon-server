generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(uuid())
  fullName   String
  email      String  @unique
  phone      String  @unique
  password   String
  role       Role
  profileImg String?
  isVerified Boolean @default(false)

  client             Client?
  driver             Driver?
  notifications      Notification[]
  verificationTokens VerificationToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id     String @id @default(uuid())
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Client {
  id             String  @id @default(uuid())
  userId         String  @unique
  companyName    String
  companyAddress String
  suiteNumber    String
  city           String
  state          USState
  zip            String
  industry       String

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Driver {
  id      String       @id @default(uuid())
  userId  String       @unique
  image   String?
  address String
  city    String
  state   USState
  zip     String
  status  DriverStatus

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             Order[]           @relation("CurrentDriverOrders")
  assignments        OrderAssignment[]
  history            OrderHistory[]
  orderTransfersFrom OrderTransfer[]   @relation("FromDriver")
  orderTransfersTo   OrderTransfer[]   @relation("ToDriver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Item {
  id     String     @id @default(uuid())
  name   String     @unique
  status ItemStatus @default(ACTIVE)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  clientId        String?
  itemId          String
  currentDriverId String?
  currentCity     String?
  deliveryCity    String?
  specialNote     String?
  status          OrderStatus @default(CREATED)
  type            OrderType
  createdById     String
  createdByRole   OrderRole

  client          Client?           @relation(fields: [clientId], references: [id])
  item            Item              @relation(fields: [itemId], references: [id])
  currentDriver   Driver?           @relation("CurrentDriverOrders", fields: [currentDriverId], references: [id])
  orderTransfers  OrderTransfer[]
  pickupDetails   PickupDetails?
  deliveryDetails DeliveryDetails?
  assignments     OrderAssignment[]
  history         OrderHistory[]
  notifications   Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, currentCity])
}

model OrderAssignment {
  id         String   @id @default(uuid())
  orderId    String
  driverId   String
  assignedAt DateTime

  driver Driver @relation(fields: [driverId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, driverId])
}

model OrderTransfer {
  id           String         @id @default(uuid())
  orderId      String
  fromDriverId String
  toDriverId   String
  status       TransferStatus

  order      Order  @relation(fields: [orderId], references: [id])
  fromDriver Driver @relation("FromDriver", fields: [fromDriverId], references: [id])
  toDriver   Driver @relation("ToDriver", fields: [toDriverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderHistory {
  id       String      @id @default(uuid())
  orderId  String
  driverId String?
  status   OrderStatus
  notes    String?

  driver Driver? @relation(fields: [driverId], references: [id])
  order  Order   @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id      String  @id @default(uuid())
  userId  String
  orderId String
  type    String
  title   String
  message String
  isRead  Boolean @default(false)

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PickupDetails {
  id             String  @id @default(uuid())
  orderId        String  @unique
  contactName    String
  email          String
  phone          String
  companyName    String
  companyAddress String
  suiteNumber    String
  city           String
  state          USState
  zipCode        String

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryDetails {
  id             String  @id @default(uuid())
  orderId        String  @unique
  serviceType    String?
  contactName    String
  email          String
  phone          String
  companyName    String
  companyAddress String
  suiteNumber    String
  city           String
  state          USState
  zipCode        String

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  CLIENT
  DRIVER
}

enum DriverStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  CREATED
  AVAILABLE
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum OrderRole {
  CLIENT
  ADMIN
}

